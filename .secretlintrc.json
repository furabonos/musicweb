{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Google API key",
            "patterns": ["/AIza[0-9A-Za-z_\\-]{35}/"]
          },
          {
            "name": "Google OAuth client secret",
            "patterns": ["/GOCSPX-[A-Za-z0-9_\\-]{20,}/"]
          },
          {
            "name": "Google OAuth access token",
            "patterns": ["/ya29\\.[A-Za-z0-9_\\-]{20,}/"]
          },
          {
            "name": "Anthropic API key",
            "patterns": ["/sk-ant-[A-Za-z0-9_\\-]{20,}/"]
          },
          {
            "name": "GitHub token",
            "patterns": [
              "/(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{30,}/",
              "/github_pat_[A-Za-z0-9_]{40,}/"
            ]
          },
          {
            "name": "Private key block",
            "patterns": ["/-----BEGIN [A-Z ]*PRIVATE KEY-----/"]
          },
          {
            "name": "Secret files (use Secret Manager or functions/.secret.local, never commit)",
            "filePathGlobs": [
              "**/.env",
              "**/.env.local",
              "**/.env.*.local",
              "**/.env.production",
              "**/.env.development",
              "**/.env.staging",
              "**/.env.test",
              "**/.secret.local",
              "**/*.pem",
              "**/*.key",
              "**/*.p12",
              "**/*.pfx",
              "**/*serviceAccount*.json",
              "**/*service-account*.json"
            ]
          }
        ]
      }
    }
  ]
}
