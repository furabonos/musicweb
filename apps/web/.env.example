# 화면 설정 예시. Firebase 웹 설정은 공개값이다(비밀 아님).
# 배포용 값은 apps/web/.env.production.local(gitignore)에 둔다: 배포 빌드만 읽고 개발 서버·e2e는 읽지 않는다(T23).
# pnpm deploy:prepare가 빠진 값을 검사한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check(reCAPTCHA Enterprise) 사이트 키. 공개값. 배포 빌드에 꼭 필요(없으면 서버가 모든 호출을 거부)
VITE_RECAPTCHA_SITE_KEY=
# 로컬 에뮬레이터에 붙을 때만 true (pnpm emulators와 함께). 배포 빌드에서는 비워 둔다.
VITE_USE_EMULATORS=
