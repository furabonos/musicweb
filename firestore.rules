rules_version = '2';

// 보안 규칙 (SPEC 5장, T03).
// - 기본은 전부 거부. 아래에 적은 "읽기"만 연다.
// - 클라이언트 쓰기는 어디에도 없다. 모든 쓰기는 Cloud Functions(관리자 권한 SDK)로만 한다.
//   tools/firestore-rules-static.test.ts가 쓰기 허용 줄이 생기면 실패시킨다.
// - secrets_oauth, events, issueFingerprints, 미리 계산·캐시(artistSimilar, artistVectors, parseCache, resultCache 등)는
//   match 자체가 없어 누구도 읽지 못한다(서버 전용, tests/rules/server-only.test.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // 관리자 표시는 서버가 ADMIN_EMAILS 기준으로 붙이는 사용자 정의 클레임. 불리언 true만 인정한다.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // 곡 목록: 누구나. 연결은 active만 (쿼리도 status == 'active'로 걸러야 함).
    match /songs/{songId} {
      allow read: if true;
      match /links/{videoId} {
        allow read: if resource.data.status == 'active';
      }
    }

    // 재생목록 (D-019):
    // - 한 건 읽기(get): 저장(공유)된 것은 공유 주소를 아는 누구나, draft는 소유자만.
    // - 목록 조회(list): 소유자 자기 것만. 공유된 재생목록 전체를 한 번에 긁어 가지 못하게 한다.
    match /playlists/{playlistId} {
      allow get: if resource.data.state == 'saved' || isUser(resource.data.ownerUid);
      allow list: if isUser(resource.data.ownerUid);
      // 검색 문장 원문·해석 결과: 소유자만 (관리자도 기본으로 못 봄). SPEC 5장대로 request 문서 하나만.
      match /private/request {
        allow read: if isUser(get(/databases/$(database)/documents/playlists/$(playlistId)).data.ownerUid);
      }
    }

    match /users/{uid} {
      allow read: if isUser(uid);
      match /usage/{day} {
        allow read: if isUser(uid);
      }
    }

    // 이 앱이 만든 YouTube 재생목록 기록: 본인만.
    match /ytExports/{exportId} {
      allow read: if isUser(resource.data.ownerUid);
    }

    // 긴급 정지·한도: 안내 문구용으로 누구나 읽음. 다른 config 문서는 비공개.
    match /config/runtime {
      allow read: if true;
    }

    // 현황판: 누구나 읽음.
    match /metrics/{metricId} {
      allow read: if true;
    }
    match /opsLog/{entryId} {
      allow read: if true;
    }

    // 관리자 전용 읽기.
    match /artists/{artistId} {
      allow read: if isAdmin();
    }
    match /usage/{day} {
      allow read: if isAdmin();
    }
    match /adminAudit/{entryId} {
      allow read: if isAdmin();
    }
  }
}
