# 로컬 에뮬레이터용 비밀값 예시. 복사해서 functions/.secret.local 로 쓰고(gitignore됨) 값을 채운다.
# 실제 배포 값은 Secret Manager에 넣는다: firebase functions:secrets:set <NAME>
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=
LASTFM_API_KEY=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# "v1:<base64 32바이트>" — 만들기: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=
ACTOR_HASH_KEY=
GITHUB_ISSUE_TOKEN=
